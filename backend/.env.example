# Copy this file to .env and fill in real values. Never commit .env.

# ---- Database (PostgreSQL) ----
# Example providers: Neon, Supabase, Railway Postgres, Render Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ---- Auth ----
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# ---- Initial developer/admin account (used once by prisma/seed.js) ----
# After first login, change this password from Settings -> Profile.
ADMIN_NAME="Developer"
ADMIN_EMAIL="you@example.com"
ADMIN_MOBILE="9999999999"
ADMIN_PASSWORD="Choose-A-Strong-Password1"

# ---- YouTube Data API v3 (server-side only — never exposed to the browser) ----
YOUTUBE_API_KEY="your-youtube-data-api-v3-key"

# ---- Cloud storage: Cloudinary (photos/videos for hero items, avatars, dev photo) ----
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ---- Server / CORS ----
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGIN="https://your-frontend.vercel.app,https://your-custom-domain.com"
CORS_ORIGIN="http://localhost:5500"
